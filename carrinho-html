<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Muchiko - Carrinho</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
    <header>
        <div class="logo-container">
            <img src="{{ url_for('static', filename='icon.webp') }}" alt="Logo Muchiko" class="logo-icon" onerror="this.style.display='none'">
            <h1 class="logo-title">MUCHIKO</h1>
        </div>
        <nav>
            <a href="/loja">← Voltar para a Loja</a>
        </nav>
    </header>

    <div class="container">
        <h2 class="page-title">Seu Carrinho de Compras</h2> 

        {% if mensagem %} 
            <div class="alert-msg">{{ mensagem }}</div> 
        {% endif %} 

        <div class="cart-card">
            {% if not carrinho.itens %} 
                <p>Seu carrinho está vazio no momento.</p> 
            {% else %}
                <table class="cart-table"> 
                    <thead>
                        <tr> 
                            <th>Produto</th> 
                            <th>Preço Unitário</th> 
                            <th>Qtd</th>
                            <th>Subtotal</th> 
                            <th>Ação</th> 
                        </tr> 
                    </thead> 
                    <tbody>
                        {% for item in carrinho.itens %}
                            <tr>
                                <td><strong>{{ item.produto.nome }}</strong></td>
                                <td>R$ {{ "%.2f"|format(item.produto.preco_unitario) }}</td> 
                                <td>{{ item.quantidade }}</td>
                                <td>R$ {{ "%.2f"|format(item.subtotal) }}</td>
                                <td>
                                    <form action="/remover_carrinho" method="POST">
                                        <input type="hidden" name="id_produto" value="{{ item.produto.id_produto }}">
                                        <button type="submit" class="btn-danger">Remover</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="cart-summary">
                    <div class="total-price">Total: R$ {{ "%.2f"|format(carrinho.valor_total) }}</div>
                    <form action="/finalizar_compra" method="POST">
                        <button type="submit" class="btn-primary" style="padding: 12px 24px;">Finalizar Compra</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</body>
</html>
