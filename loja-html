<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loja Muchiko</title>
</head>
<body>
    <h1>Vitrine de Produtos</h1>
    
    {% if mensagem %}
        <p style="color: rgb(#89CAD9);"><strong>{{ mensagem }}</strong></p>
    {% endif %}

    {% for produto in lista_produto %}
        <td>{{ produto.id_produto }}</td>
        <td>{{ produto.nome }}</td>
        <td>R$ {{ "%.2f"|format(produto.preco\_unitario) }}</td>
        <td>{{ produto.quantidade_estoque }}</td>
    
    <form auction="/adicionar_carrinho" method="POST"></form>
        <input type="hidden" name="id_produto" value="{{ produto.id_produto }}">
        <input type="number" name="quantidade" value="1" min="1" max="{{ produto.quantidade_estoque}}">
        <button type="submit" {% if not produto.esta_disponivel() %}disabled{% endif %}>
        {% if produto.esta_disponivel() %}Adicionar ao Carrinho{% else %}Esgotado{% endif %}
    </button>
</form>


</body>
</html> 
